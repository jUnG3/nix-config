{
  "$schema": "https://opencode.ai/config.json",
  "model": "Local Lemonade/qwen3.5-9b-FLM",
  "providers": {
    "Local Lemonade": {
      "name": "Lemonade",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "lemonade",
        "baseURL": "http://localhost:13305/v1"
      },
      "models": {
        "llama3.2-3b-FLM": {
          "name": "llama3.2-3b-FLM (local)",
          "limit": {
            "context": 131072,
            "output": 13653
          }
        },
        "gemma4-it-e4b-FLM": {
          "name": "gemma4-it-e4b-FLM (local)",
          "limit": {
            "context": 131072,
            "output": 13653
          }
        },
        "qwen3.5-9b-FLM": {
          "name": "qwen3.5-9b-FLM (local)",
          "limit": {
            "context": 262144,
            "output": 13653
          }
        },
        "Qwen3.5-35B-A3B-GGUF": {
          "name": "Qwen3.5-35B-A3B-GGUF (local)",
          "limit": {
            "context": 262144,
            "output": 13653
          }
        }
      }
    },
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "ollama",
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "ministral-3:3b-16k": {
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "requireFinishReason": false
          }
        },
        "llama3.1:8b-16k": {
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen3.5:4b-16k": {
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "plugins": [
    "opencode-parser",
    "@ramtinj95/opencode-tokenscope@latest"
  ],
  "mcp": {
    "servers": {
      "outlook": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@softeria/ms-365-mcp-server",
          "--preset",
          "mail"
        ],
        "codemode": true,
        "environment": {
          "MS365_MCP_TENANT_ID": "consumers"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "codemode": true
      },
      "linkedin": {
        "type": "local",
        "command": [
          "linkedin-mcp"
        ],
        "codemode": true,
        "timeout": 120000
      }
    }
  },
  "permissions": [
    {
      "action": "outlook_*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
